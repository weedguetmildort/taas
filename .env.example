# Copy to .env and adjust as needed. .env is gitignored

# Port WordPress is served on locally: http://localhost:8080
WP_PORT=8080

# Set up database for GUI tools like TablePlus
DB_BIND_IP=127.0.0.1
DB_PORT=3307

# Local database credentials, read only when the database is first created
DB_NAME=taas_local
DB_USER=taas
DB_PASSWORD=taas_local_password
DB_ROOT_PASSWORD=root_local_password

# Simulate TAAS_Auth locally (student | instructor | hr | admin)
TAAS_LOCAL_DEV_USER=student
