# Copy to .env and adjust as needed. .env is gitignored.

# Port WordPress is served on locally: http://localhost:8080
WP_PORT=8080

# Local database credentials
DB_HOST=host
DB_PORT=port
DB_NAME=taas_local
DB_USER=taas
DB_PASSWORD=taas_local_password
DB_ROOT_PASSWORD=root_local_password

# Simulate TAAS_Auth locally (student | instructor | hr_admin)
TAAS_LOCAL_DEV_USER=student
