# Root main ignore
/cgi-bin/
/logs/
/mysql_credentials

# Root keep .htaccess and wp-content/
/htdocs/*
!/htdocs/.htaccess
!/htdocs/wp-content/

# wp-content/ keep plugins/ only
/htdocs/wp-content/*
!/htdocs/wp-content/plugins/

# plugins/ keep the TAAS plugins only
/htdocs/wp-content/plugins/*
!/htdocs/wp-content/plugins/taas-core/
!/htdocs/wp-content/plugins/taas-student-application-page/

# Sensitive files
wp-config.php
.env
*.log

# Local tooling and data
/vendor/
/real-data
.phpunit.cache/

# PHP storm junk files
.idea/
